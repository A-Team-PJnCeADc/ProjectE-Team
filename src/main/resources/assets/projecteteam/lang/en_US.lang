pe.team.usage=/projecte_team <create|invite|members|kick|leave|transfer_owner|settings|accept|decline>\n/projecte_team create [name] - Create a team (default name: <player> team)\n/projecte_team invite <player> - Invite a player to your team (creates the team if you have none)\n/projecte_team accept - Accept a pending invitation\n/projecte_team decline - Decline a pending invitation\n/projecte_team members - List team members\n/projecte_team kick <player> - Kick a member (owner only)\n/projecte_team leave - Leave your team\n/projecte_team transfer_owner <player> - Transfer ownership (owner only)\n/projecte_team settings share_emc <true|false> - Share EMC (default: true)\n/projecte_team settings share_knowledge <true|false> - Share knowledge (default: true)
pe.team.create.usage=/projecte_team create [name]
pe.team.create.already=You are already in a team!
pe.team.create.success=Team "%s" created! You are now the owner.
pe.team.invite.usage=/projecte_team invite <player>
pe.team.invite.notfound=Player not found or not online: %s
pe.team.invite.self=You cannot invite yourself!
pe.team.invite.already=That player is already in a team!
pe.team.invite.created=Team "%s" created! You are now the owner.
pe.team.invite.sent=Invitation sent to %s. Waiting for them to accept.
pe.team.invite.notify=%s invited you to their team! Type /projecte_team accept to join, or /projecte_team decline to refuse.
pe.team.accept.usage=/projecte_team accept
pe.team.accept.noinvite=You have no pending invitation!
pe.team.decline.usage=/projecte_team decline
pe.team.decline.noinvite=You have no pending invitation!
pe.team.decline.declined=You declined the invitation.
pe.team.notify.joined=You joined %s's team. Your EMC and knowledge now belong to the team; leaving restores your own.
pe.team.notify.kicked=You were kicked from the team by %s! Your own EMC and knowledge were restored.
pe.team.notify.accepted=%s accepted your invitation and joined the team!
pe.team.notify.declined=%s declined your invitation.
pe.team.notify.left=%s left the team.
pe.team.notify.newowner=%s made you the new team owner!
pe.team.members.header=Team %s members:
pe.team.kick.usage=/projecte_team kick <player>
pe.team.kick.notonline=That player is not online!
pe.team.kick.self=You cannot kick yourself, use /projecte_team leave instead!
pe.team.kick.notmember=That player is not in your team!
pe.team.leave.disbanded=You left and disbanded the team.
pe.team.leave.transferred=You left the team. Ownership was transferred to the first member.
pe.team.transfer.usage=/projecte_team transfer_owner <player>
pe.team.transfer.notonline=That player is not online!
pe.team.transfer.self=You cannot transfer ownership to yourself!
pe.team.transfer.notmember=That player is not in your team!
pe.team.settings.usage=/projecte_team settings <share_emc|share_knowledge> <true|false>
pe.team.settings.badvalue=Invalid value! Use true or false.
pe.team.settings.invalid=Unknown setting! Use share_emc or share_knowledge.
pe.team.settings.enabled=%s enabled for the team.
pe.team.settings.disabled=%s disabled for the team.
pe.team.error.ingame=This command must be run by a player in-game!
pe.team.error.noworld=Team data is not available yet, try again in a moment.
pe.team.error.noteam=You are not in a team!
pe.team.error.notowner=Only the team owner can do this!
